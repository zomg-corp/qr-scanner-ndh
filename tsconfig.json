{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitReturns": true,
