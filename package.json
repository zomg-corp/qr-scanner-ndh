{
  "name": "qr-scanner-ndh",
  "version": "1.4.7",
  "description": "A javascript QR scanner library",
  "main": "qr-scanner.umd.min.js",
  "module": "qr-scanner.min.js",
  "types": "types/qr-scanner.d.ts",
  "files": [
    "LICENSE",
    "qr-scanner.min.js",
    "qr-scanner.min.js.map",
    "qr-scanner.umd.min.js",
    "qr-scanner.umd.min.js.map",
    "qr-scanner.legacy.min.js",
    "qr-scanner.legacy.min.js.map",
    "qr-scanner-worker.min.js",
    "qr-scanner-worker.min.js.map",
    "types/qr-scanner.d.ts",
    "src"
  ],
  "scripts": {
    "build": "rollup --config && node node_modules/typescript/bin/tsc --ignoreConfig src/qr-scanner.ts --target esnext --module esnext --declaration --declarationDir types --emitDeclarationOnly",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p test/tsconfig.json",
    "typecheck:admin": "node node_modules/typescript-admin/bin/tsc -p tsconfig.admin.json",
    "test": "vitest --run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zomg-corp/qr-scanner-ndh.git"
  },
  "keywords": [
    "qr",
    "scanner",
    "reader",
    "js",
    "javascript",
    "lightweight",
    "small",
    "fast",
    "web"
  ],
  "author": "Nimiq (https://nimiq.com)",
  "contributors": [
    {
      "name": "iam-sysop",
      "url": "https://github.com/iam-sysop"
    },
    {
      "name": "dcrawshay",
      "url": "https://github.com/dcrawshay"
    },
    {
      "name": "alsherko",
      "url": "https://github.com/alsherko"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zomg-corp/qr-scanner-ndh/issues"
  },
  "homepage": "https://github.com/zomg-corp/qr-scanner-ndh#readme",
  "devDependencies": {
    "@ampproject/rollup-plugin-closure-compiler": "^0.27.0",
    "@rollup/plugin-alias": "^3.1.9",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24",
    "acorn": "^8.7.0",
    "google-closure-compiler": "^20220104.0.0",
    "rollup": "^2.80.0",
    "rollup-plugin-sourcemaps": "^0.6.2",
    "tslib": "^2.3.1",
    "typescript": "^6.0.3",
    "typescript-admin": "npm:typescript@7.1.0-beta",
    "upng-js": "^1.0.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
